    "index.d.ts"
  ],
  "exports": {
    ".": {
      "import": "./index.esm.js",
      "require": "./index.cjs.js",
      "types": "./index.d.ts"
    }
  },
  "scripts": {
    "build": "node build-modules.js",
    "prepare": "node build-modules.js",
    "test": "node test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalloggers/race-as-promised.git"
  },
